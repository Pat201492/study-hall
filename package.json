{
  "name": "study-hall",
  "version": "0.1.0",
  "private": true,
  "description": "Study Room v2: a multi-provider warm pool of coding-agent CLIs driving GitHub boards, with a planning terminal, durable run history, and per-provider quota display.",
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=22.5" },
  "scripts": {
    "test": "node --import tsx --test \"packages/*/test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dashboard": "tsx packages/dashboard/src/server.ts",
    "engine": "tsx packages/core/src/index.ts"
  },
  "dependencies": { "tsx": "^4.19.2" },
  "devDependencies": { "@types/node": "^22.9.0", "typescript": "^5.6.3" }
}
